# ==========================================
# ROS 2 工作空间核心生成目录 (绝对不能提交)
# ==========================================
build/
install/
log/
build
install
log

# 忽略为了防止在某些子目录被 colcon 编译而手动加的标志文件
COLCON_IGNORE
AMENT_IGNORE

# ==========================================
# C/C++ 编译产物
# ==========================================
*.o
*.obj
*.so
*.so.*
*.dylib
*.a
*.lib
*.out
*.app

# ==========================================
# Python 缓存和虚拟环境
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.env
venv/
env/

# ==========================================
# IDE 和 编辑器配置文件 (视个人习惯可保留 .vscode/tasks.json 等)
# ==========================================
.vscode/
.idea/
.cache/
*.swp
*.swo
*~
*.bak

# ==========================================
# 操作系统自动生成的文件
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/