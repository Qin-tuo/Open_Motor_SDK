# ==========================
# 1. 编译构建目录 (最重要的)
# ==========================
build/
cmake-build-debug/
cmake-build-release/
bin/

# ==========================
# 2. CMake 生成的临时文件
# ==========================
CMakeCache.txt
CMakeFiles/
Makefile
*.cmake
*.ctest
*.cpack

# ==========================
# 3. 编译产生的中间文件
# ==========================
*.o
*.obj
*.a
# 忽略所有 .so 文件 (防止编译生成的动态库被提交)
*.dylib
*.dll


# ==========================
# 4. 最终生成的可执行文件
# ==========================
# 你的程序名字
lingzu_robot
# 也可以忽略所有无后缀文件(比较激进，视情况开启)
# *

# ==========================
# 5. IDE 和 编辑器生成的配置
# ==========================
.vscode/
.idea/
.vs/
*.swp
*~
.DS_Store

# ==========================
# 6. ROS2 相关的 (如果未来集成到colcon编译)
# ==========================
install/
log/